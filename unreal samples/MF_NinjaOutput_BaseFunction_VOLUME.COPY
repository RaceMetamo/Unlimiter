   Begin Object Name="MaterialExpressionStaticSwitchParameter_5" ExportPath="/Script/Engine.MaterialExpressionStaticSwitchParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionStaticSwitchParameter_5'"
      A=(Expression="/Script/Engine.MaterialExpressionMaterialFunctionCall'MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionMaterialFunctionCall_8'")
      B=(Expression="/Script/Engine.MaterialExpressionTextureSample'MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionTextureSample_8'",Mask=1,MaskR=1,MaskG=1,MaskB=1)
      ParameterName="Noise1FlowByVelocity"
      ExpressionGUID=221A3C11489840B846D39089536D3814
      Group="Noise"
      SortPriority=2
      MaterialExpressionEditorX=-6224
      MaterialExpressionEditorY=1248
      MaterialExpressionGuid=FD1344E149163DEB2E4444A5424B1ADC
      Function="/Script/Engine.MaterialFunction'MF_NinjaOutput_BaseFunction_VOLUME'"
      Desc="Noise detail maps work even better, if we are advecting them using a flowmap.\r\nFlowmap is a directional field - horizontal direction encoded on the RED channel,\r\nvertical direction encoded on GREEN. A flowmap could be a classic texture - in this case\r\nthe information is stored in the 0-1 range (0.5 being the midpoint).\r\nThe flowmap could also come from real time fluidsim - in this case,\r\nthe information is stored in the (-1) to (+1) value range (0 being the midpoint)\r\n.\r\nIMPORTANT: we need to tell the flow function about the RANGE we are using.\r\nSee \"UseNormalizedInputVelocity\" param in the DENSITY param group!"
   End Object
