   Begin Object Name="MaterialExpressionTextureObjectParameter_12" ExportPath="/Script/Engine.MaterialExpressionTextureObjectParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionTextureObjectParameter_12'"
      ParameterName="NoiseOnCrossSections"
      ExpressionGUID=BF5526564B7E35F0F3F03281C920A854
      Group="XCrossSectionBasedDensity"
      SortPriority=12
      Texture="/Script/Engine.Texture2D'/Game/FluidNinjaLive/Textures/T_Crumple_mod_inv.T_Crumple_mod_inv'"
      MaterialExpressionEditorX=-7968
      MaterialExpressionEditorY=-1440
      MaterialExpressionGuid=F0A73F5D4753B3ED7FF22DB2F2B1A9D8
      Function="/Script/Engine.MaterialFunction'MF_NinjaOutput_BaseFunction_VOLUME'"
      bCollapsed=True
   End Object
   Begin Object Name="MaterialExpressionTextureObjectParameter_13" ExportPath="/Script/Engine.MaterialExpressionTextureObjectParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionTextureObjectParameter_13'"
      ParameterName="VerticalCrossSection"
      ExpressionGUID=768BC67540CBBAE73281E5BE7B5F55BE
      Group="XCrossSectionBasedDensity"
      SortPriority=24
      Texture="/Script/Engine.Texture2D'/Game/FluidNinjaLive/Textures/CrossSectionTextures/T_CrossSection1_DensityVelocity_Combo.T_CrossSection1_DensityVelocity_Combo'"
      MaterialExpressionEditorX=-6768
      MaterialExpressionEditorY=-1504
      MaterialExpressionGuid=11F955CD4505F912BF87EBAFF44D838D
      Function="/Script/Engine.MaterialFunction'MF_NinjaOutput_BaseFunction_VOLUME'"
      Desc="A vertical cross section comes here. \r\nTechnically, it is a HALF cross section that is pushed in 3D by UV tricks.\r\nThe UV comes from the DENSITY INPUT. Depending on the UV, the section could work like a LATHE,\r\ndefining density through radial symmetry. It could also work like \"extrude\" to form walls.\r\nSee the included use cases and a simple example Material to grasp the concept: \"M_CrossSectionBased3DVolume_VerySimpleExample\""
   End Object
