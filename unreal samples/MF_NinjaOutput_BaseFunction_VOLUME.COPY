   Begin Object Name="MaterialExpressionStaticSwitchParameter_67" ExportPath="/Script/Engine.MaterialExpressionStaticSwitchParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionStaticSwitchParameter_67'"
      A=(Expression="/Script/Engine.MaterialExpressionAdd'MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionAdd_11'")
      B=(Expression="/Script/Engine.MaterialExpressionNamedRerouteUsage'MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionNamedRerouteUsage_44'")
      ParameterName="DecoupleSimAndVolume"
      ExpressionGUID=333A25374A26FC4C5BEB98A66D384356
      Group="Transforms"
      SortPriority=100
      MaterialExpressionEditorX=-14896
      MaterialExpressionEditorY=-496
      MaterialExpressionGuid=937CB2BC40C8B2E3DA6E70B7E9861ADE
      Function="/Script/Engine.MaterialFunction'MF_NinjaOutput_BaseFunction_VOLUME'"
      Desc="USE IF SIM AREA SIZE IS NOT EQUAL TO VOLUME SIZE\r\n.\r\nWARNING: TO UTILIZE THIS FEATURE, MAKE SURE BOTH DENSITY AND NOISE ARE SWITCHED TO WORLD-SPACE MODE!\r\nBy enabling this switch, we define a special area inside the volume - usually fed with simulated density and velocity (\"sim area\"). \r\nThe simulated area could be smaller or larger than the volume - and it could move independently. \r\nEg.: a large, passive (non-simulated) noisy fog container - with a smaller, interactive (simulated) area directly surrounding the player."
   End Object
   Begin Object Name="MaterialExpressionStaticSwitchParameter_68" ExportPath="/Script/Engine.MaterialExpressionStaticSwitchParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionStaticSwitchParameter_68'"
      A=(Expression="/Script/Engine.MaterialExpressionStaticSwitchParameter'MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionStaticSwitchParameter_66'")
      B=(Expression="/Script/Engine.MaterialExpressionNamedRerouteUsage'MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionNamedRerouteUsage_4'")
      ParameterName="DecoupleSimAndVolume"
      ExpressionGUID=BD4E8E184ACA803DEFF072B08F842C0C
      Group="Transforms"
      SortPriority=100
      MaterialExpressionEditorX=-4208
      MaterialExpressionEditorY=1840
      MaterialExpressionGuid=1A1018E44CEADB4C1CE5E1A1F3985145
      Function="/Script/Engine.MaterialFunction'MF_NinjaOutput_BaseFunction_VOLUME'"
      Desc="USE IF SIM AREA SIZE IS NOT EQUAL TO VOLUME SIZE\r\n.\r\nWARNING: TO UTILIZE THIS FEATURE, MAKE SURE BOTH DENSITY AND NOISE ARE SWITCHED TO WORLD-SPACE MODE!\r\nBy enabling this switch, we define a special area inside the volume - usually fed with simulated density and velocity (\"sim area\"). \r\nThe simulated area could be smaller or larger than the volume - and it could move independently. \r\nEg.: a large, passive (non-simulated) noisy fog container - with a smaller, interactive (simulated) area directly surrounding the player."
   End Object
   Begin Object Name="MaterialExpressionStaticSwitchParameter_69" ExportPath="/Script/Engine.MaterialExpressionStaticSwitchParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionStaticSwitchParameter_69'"
      A=(Expression="/Script/Engine.MaterialExpressionMultiply'MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionMultiply_77'")
