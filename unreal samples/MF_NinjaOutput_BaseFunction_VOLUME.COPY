      A=(Expression="/Script/Engine.MaterialExpressionPower'MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionPower_16'")
      B=(Expression="/Script/Engine.MaterialExpressionMultiply'MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionMultiply_23'")
      ParameterName="Define3DVolumeViaCrossSections"
      ExpressionGUID=A6C276514C8DB68FDF9258AFC919C037
      Group="XCrossSectionBasedDensity"
      SortPriority=0
      MaterialExpressionEditorX=-5680
      MaterialExpressionEditorY=-544
      MaterialExpressionGuid=32DCADD648F7062D414A359E14EABD8C
      Function="/Script/Engine.MaterialFunction'MF_NinjaOutput_BaseFunction_VOLUME'"
      Desc="By default, we are generating 3D volumetric density from the 2D input data by EXTRUSION.\r\nUsing THIS option, we could define 3D density using (A) an extra VERTICAL (XZ) CROSS SECTION,\r\n(B) while the original 2D density input is being used for horizontal mapping (XY).\r\n.\r\n2D Fluidsim could be channelled for BOTH inputs (A,B)\r\nNOTE: ninja could drive automatically ONLY the original density input.\r\nTo use fluidsim as vertical section: we need to write the sim to a RenderTarget with ninja,\r\nand MANUALLY provide the RenderTarget to the material, using the below \"VerticalCrossSection\" param"
   End Object
   Begin Object Name="MaterialExpressionStaticSwitchParameter_76" ExportPath="/Script/Engine.MaterialExpressionStaticSwitchParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionStaticSwitchParameter_76'"
