   Begin Object Name="MaterialExpressionStaticSwitchParameter_103" ExportPath="/Script/Engine.MaterialExpressionStaticSwitchParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionStaticSwitchParameter_103'"
      A=(Expression="/Script/Engine.MaterialExpressionLinearInterpolate'MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionLinearInterpolate_9'")
      B=(Expression="/Script/Engine.MaterialExpressionReroute'MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionReroute_93'")
      ParameterName="DecoupleSimAndVolume"
      ExpressionGUID=9BB862704D4EDDCB1BB3F3977D2B2EC7
      Group="Transforms"
      SortPriority=100
      MaterialExpressionEditorX=-9104
      MaterialExpressionEditorY=16
      MaterialExpressionGuid=F78700304D2A96D007AD62AE0547C191
      Function="/Script/Engine.MaterialFunction'MF_NinjaOutput_BaseFunction_VOLUME'"
      Desc="USE IF SIM AREA SIZE IS NOT EQUAL TO VOLUME SIZE\r\n.\r\nWARNING: TO UTILIZE THIS FEATURE, MAKE SURE BOTH DENSITY AND NOISE ARE SWITCHED TO WORLD-SPACE MODE!\r\nBy enabling this switch, we define a special area inside the volume - usually fed with simulated density and velocity (\"sim area\"). \r\nThe simulated area could be smaller or larger than the volume - and it could move independently. \r\nEg.: a large, passive (non-simulated) noisy fog container - with a smaller, interactive (simulated) area directly surrounding the player."
   End Object
   Begin Object Name="MaterialExpressionStaticSwitchParameter_104" ExportPath="/Script/Engine.MaterialExpressionStaticSwitchParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionStaticSwitchParameter_104'"
