      Function="/Script/Engine.MaterialFunction'MF_NinjaOutput_BaseFunction_VOLUME'"
      Desc="In case we use \"decouple\" - but we DO NOT drive our volume with ninja (eg. density input is a static texture),\r\nwe could use the decoupled area as the center-area of our volume - by setting this param to TRUE.\r\nIn this case, \"TraceMeshSize\" param should be adjusted manually."
   End Object
   Begin Object Name="MaterialExpressionStaticSwitchParameter_66" ExportPath="/Script/Engine.MaterialExpressionStaticSwitchParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionStaticSwitchParameter_66'"
