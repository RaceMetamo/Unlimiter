      Group="Color"
      SortPriority=1
      MaterialExpressionEditorX=-720
      MaterialExpressionEditorY=-624
      MaterialExpressionGuid=D432186C4557171B91A767A0B22BB632
      Function="/Script/Engine.MaterialFunction'MF_NinjaOutput_BaseFunction_VOLUME'"
      Desc="Darkens base-color, where density is lower. This feature could be used to imitate self-shadows\r\non volume types that do not support self-shadows --- FOG volumes, for example"
   End Object
