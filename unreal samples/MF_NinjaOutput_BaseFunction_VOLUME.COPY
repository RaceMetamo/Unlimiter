      MaterialExpressionEditorX=-5936
      MaterialExpressionEditorY=1584
      MaterialExpressionGuid=C69019CF4D1586AC13D5448D6DA69301
      Function="/Script/Engine.MaterialFunction'MF_NinjaOutput_BaseFunction_VOLUME'"
      Desc="By default we subtract noise from density.\r\nIn case we are using ADDITIVE noise (\"Noise1ValueOffset\" param is NEGATIVE),\r\nthe noise fills the entire volume. We could MASK this noise with density!"
   End Object
