   Begin Object Name="MaterialExpressionStaticSwitchParameter_107" ExportPath="/Script/Engine.MaterialExpressionStaticSwitchParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionStaticSwitchParameter_107'"
      A=(Expression="/Script/Engine.MaterialExpressionNamedRerouteUsage'MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionNamedRerouteUsage_70'")
      B=(Expression="/Script/Engine.MaterialExpressionAppendVector'MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionAppendVector_9'")
      ParameterName="Make3DVelocityViaCrossSections"
      ExpressionGUID=0380E2E747C3F0E1A037BCB40B498F48
      Group="XCrossSectionBasedDensity"
      SortPriority=30
      MaterialExpressionEditorX=-10112
      MaterialExpressionEditorY=1616
      MaterialExpressionGuid=2906D0214A5266C91884CE87C2A41EFC
      Function="/Script/Engine.MaterialFunction'MF_NinjaOutput_BaseFunction_VOLUME'"
      Desc="In case we\'d like to advect 3D noise along the cross section defined density surfaces,\r\nwe could provide the material with a \"velocity cross section\", that is being turned\r\ninto a \"velocity volume\" much the same way as the density.\r\nFor example: we have a mushroom cloud - and detail noise flows \"inward\" at the bottom,\r\n\"upward\" at the middle, \"outward\" at the top, and \"downward\" at the edges.\r\n.\r\nNOTE: making 3D velocity volume is performance heavy! (+10-15%, compared to \"no velocity\")"
   End Object
   Begin Object Name="MaterialExpressionStaticSwitchParameter_108" ExportPath="/Script/Engine.MaterialExpressionStaticSwitchParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionStaticSwitchParameter_108'"
