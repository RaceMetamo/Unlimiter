   Begin Object Name="MaterialExpressionScalarParameter_2" ExportPath="/Script/Engine.MaterialExpressionScalarParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionScalarParameter_2'"
      DefaultValue=0.200000
      ParameterName="Extrude"
      ExpressionGUID=410AC76C46B17081BE2A0DBE86024DB5
      Group="Density"
      SortPriority=1
      MaterialExpressionEditorX=-7472
      MaterialExpressionEditorY=-128
      MaterialExpressionGuid=F0E07B34458CFF568AEE748E4C96EC31
      Function="/Script/Engine.MaterialFunction'MF_NinjaOutput_BaseFunction_VOLUME'"
      Desc="\"Extruding\" is a method to create 3D data from 2D input. The input is used like an \"elevation map\",\r\nbrighter values are EXTRUDED more from the 2D base-plane, forming \"peaks\", darker values form \"valleys\".\r\nWe could vertically scale our \"mountains\" using THIS variable.\r\nFor a non-extrude based method, see \"XCrossSectionBasedDensity\" parameter group, below."
   End Object
   Begin Object Name="MaterialExpressionScalarParameter_20" ExportPath="/Script/Engine.MaterialExpressionScalarParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionScalarParameter_20'"
