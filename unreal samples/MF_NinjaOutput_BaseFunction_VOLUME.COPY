   Begin Object Name="MaterialExpressionTextureObjectParameter_0" ExportPath="/Script/Engine.MaterialExpressionTextureObjectParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionTextureObjectParameter_0'"
      ParameterName="VelocityDensityBuffer"
      ExpressionGUID=C2FEC3554677B8F59C2590A2EAFBBAAD
      Group="Density"
      SortPriority=-80
      Texture="/Script/Engine.Texture2D'/Game/FluidNinjaLive/Core/Assets/T_1x1_black_RGBA.T_1x1_black_RGBA'"
      MaterialExpressionEditorX=-10784
      MaterialExpressionEditorY=48
      MaterialExpressionGuid=9065FE00470FB00C500AFEAB45255D18
      Function="/Script/Engine.MaterialFunction'MF_NinjaOutput_BaseFunction_VOLUME'"
      Desc="DensityBuffer\r\nGrayscale 2D input texture for the volume. We are EXTRUDING the data from the 2D base-plane\r\nto generate 3D density. Brighter values are EXTRUDED more, so the grayscale 2D input is used like an \"elevation map\".\r\nIn case the Density is provided together with Velocity, the material is assuming it is encoded on the BLUE channel.\r\nIn case Density is a separate texture: we assume it is on the RED channel.\r\n\r\nVelocityBuffer\r\nWe could provide the volume material with a 2D directional field (\"velocity\"), to advect 3D noise,\r\nmeant to add details to the volume density.\r\nThe material is assuming \"velocity\" is encoded on the RED and GREEN channels."
      bCollapsed=True
   End Object
   Begin Object Name="MaterialExpressionTextureObjectParameter_1" ExportPath="/Script/Engine.MaterialExpressionTextureObjectParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionTextureObjectParameter_1'"
      ParameterName="EdgeMaskTexture"
      ExpressionGUID=24C7570547A71152B355A38E1A83E377
      Group="Fading"
      SortPriority=109
      Texture="/Script/Engine.Texture2D'/Game/FluidNinjaLive/Core/Assets/T_maskframe_thicker_256.T_maskframe_thicker_256'"
      SamplerType=SAMPLERTYPE_Alpha
      MaterialExpressionEditorX=-3152
      MaterialExpressionEditorY=1856
      MaterialExpressionGuid=C0D2B3C748C6258170E494986AD0B233
      Function="/Script/Engine.MaterialFunction'MF_NinjaOutput_BaseFunction_VOLUME'"
      bCollapsed=True
   End Object
   Begin Object Name="MaterialExpressionTextureObjectParameter_10" ExportPath="/Script/Engine.MaterialExpressionTextureObjectParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionTextureObjectParameter_10'"
