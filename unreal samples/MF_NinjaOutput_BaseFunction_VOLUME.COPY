   Begin Object Name="MaterialExpressionTextureObjectParameter_3" ExportPath="/Script/Engine.MaterialExpressionTextureObjectParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionTextureObjectParameter_3'"
      ParameterName="VelocityBuffer"
      ExpressionGUID=B50627B84F78888C14D843BD7DA55040
      Group="Density"
      SortPriority=-70
      MaterialExpressionEditorX=-10784
      MaterialExpressionEditorY=-480
      MaterialExpressionGuid=DDD4A86545B69B858AFF9EA205736109
      Function="/Script/Engine.MaterialFunction'MF_NinjaOutput_BaseFunction_VOLUME'"
      Desc="We could provide the volume material with a 2D directional field (\"velocity\"), to advect 3D noise,\r\nmeant to add details to the volume density.\r\nThe material is assuming \"velocity\" is encoded on the RED and GREEN channels."
      bCollapsed=True
   End Object
   Begin Object Name="MaterialExpressionTextureObjectParameter_4" ExportPath="/Script/Engine.MaterialExpressionTextureObjectParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionTextureObjectParameter_4'"
      ParameterName="DensityBuffer"
      ExpressionGUID=56092BED49D74102741ED2A7BE4227B0
      Group="Density"
      SortPriority=-74
      Texture="/Script/Engine.Texture2D'/Game/FluidNinjaLive/Core/Assets/T_1x1_black_RGBA.T_1x1_black_RGBA'"
      MaterialExpressionEditorX=-10784
      MaterialExpressionEditorY=-224
      MaterialExpressionGuid=E24D2E4C41EFC52449D079A9084E10D1
      Function="/Script/Engine.MaterialFunction'MF_NinjaOutput_BaseFunction_VOLUME'"
      Desc="Grayscale 2D input texture for the volume. We are EXTRUDING the data from the 2D base-plane\r\nto generate 3D density. Brighter values are EXTRUDED more, so the grayscale 2D input is used like an \"elevation map\".\r\nIn case the Density is provided together with Velocity, the material is assuming it is encoded on the BLUE channel.\r\nIn case Density is a separate texture: we assume it is on the RED channel."
      bCollapsed=True
   End Object
