   Begin Object Name="MaterialExpressionStaticSwitchParameter_71" ExportPath="/Script/Engine.MaterialExpressionStaticSwitchParameter'/Game/FluidNinjaLive/OutputMaterials/Base/MF_NinjaOutput_BaseFunction_VOLUME.MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionStaticSwitchParameter_71'"
      A=(Expression="/Script/Engine.MaterialExpressionDoubleVectorParameter'MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionDoubleVectorParameter_1'",Mask=1,MaskR=1,MaskG=1,MaskB=1)
      B=(Expression="/Script/Engine.MaterialExpressionVectorParameter'MF_NinjaOutput_BaseFunction_VOLUME:MaterialExpressionVectorParameter_4'",Mask=1,MaskR=1,MaskG=1,MaskB=1)
      DefaultValue=True
      ParameterName="LWCsupport"
      ExpressionGUID=0D9EA3D8420CA33BCDF13BB010E179E7
      Group="Transforms"
      SortPriority=103
      MaterialExpressionEditorX=-16752
      MaterialExpressionEditorY=-384
      MaterialExpressionGuid=50B4D3FF49DBF849326A47A8D4041EB6
      Function="/Script/Engine.MaterialFunction'MF_NinjaOutput_BaseFunction_VOLUME'"
      Desc="LWC (Large World Coordinates) is an Unreal Engine method that allows users to extend scenes beyond the original (UE4) 10 kilometers radius. \r\nUE uses double precision data types (floats, vectors) in large worlds. \r\nBy ENABLING this flag, we are forcing ninja MATERIALS to handle position data via Double Precision Vectors. \r\nNOTE: we need to switch on LWC support on the BLUEPRINT side too - under NinjaLiveComponent /LiveCompatibility /LWC support = TRUE"
   End Object
